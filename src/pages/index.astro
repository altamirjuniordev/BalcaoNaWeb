---
/* A pagina segue a ordem das perguntas de quem esta decidindo:
   o que e e funciona? -> vale a pena? -> o que tem dentro? -> da trabalho?
   -> quanto custa? -> e se der errado? -> uma decisao. */
import Base from '../layouts/Base.astro';
import Icones from '../components/Icones.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Calculadora from '../components/Calculadora.astro';
import Painel from '../components/Painel.astro';
import ComoComecar from '../components/ComoComecar.astro';
import Preco from '../components/Preco.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import { faq } from '../data/faq';
---
<Base
  titulo="Balcão na Web — cardápio digital sem comissão"
  descricao="Cardápio digital com endereço próprio, painel de pedidos em tempo real e comanda impressa na cozinha. Preço fixo, sem comissão."
  caminho="/"
  perguntas={faq}
>
  <Icones />
  <Nav />
  <main id="main">
    <Hero />
    <Calculadora />
    <Painel />
    <ComoComecar />
    <Preco />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
</Base>
