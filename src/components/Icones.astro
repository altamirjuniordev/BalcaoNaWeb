---
/* ==========================================================================
   Sprite de icones: cada <symbol> e desenhado uma vez aqui e usado na
   pagina com <svg class="ico"><use href="#i-nome"/></svg>. Zero requests.
   Precisa vir antes do primeiro uso, entao e o primeiro filho do <body>.
   ========================================================================== */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-wa" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3Z"/></symbol>
  <symbol id="i-counter" viewBox="0 0 24 24"><path fill="currentColor" d="M3 10h18v3H3zM5 14h2v7H5zM17 14h2v7h-2zM7 3h10l2 6H5z"/></symbol>
