---
import Icon from './Icon.astro';
import { site, linkContato } from '../data/site';

const contato = linkContato();
---
<header class="lp-nav" id="lp-nav">
  <div class="lp-nav__inner">
    <a class="lp-logo" href="/">
      <span class="lp-logo__mark" aria-hidden="true"><Icon nome="store" /></span>
      {site.nome}
    </a>

    <nav class="lp-nav__links" aria-label="Seções da página">
      <a href="#como-funciona">Como funciona</a>
      <a href="#por-que">Por que</a>
      <a href="#painel">O painel</a>
      <a href="#duvidas">Dúvidas</a>
    </nav>

    <div class="lp-nav__cta">
      {/* Os dois icones saem no HTML e o CSS mostra o certo conforme o tema.
          Antes o JS trocava o innerHTML a cada clique, o que deixava o botao
          vazio ate o script carregar. */}
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Alternar tema">
        <span class="icon-btn__claro" aria-hidden="true"><Icon nome="moon" /></span>
        <span class="icon-btn__escuro" aria-hidden="true"><Icon nome="sun" /></span>
      </button>

      <a
        class="btn btn--primary btn--sm"
        href={contato.href}
        {...contato.externo ? { target: '_blank', rel: 'noopener' } : {}}
      >Quero ver funcionando</a>
    </div>
  </div>
</header>
