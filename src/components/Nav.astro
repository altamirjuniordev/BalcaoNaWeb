---
/* ==========================================================================
   Barra do topo. Lei de Jakob: logo a esquerda volta ao inicio, "Entrar" a
   direita, CTA no canto. Hick: 3 destinos, um por pergunta que trava a
   venda. O `data-spy` liga cada link a secao que ele marca como atual
   (landing.js).
   ========================================================================== */
import Logo from './Logo.astro';
import BotaoWhats from './BotaoWhats.astro';
import { site } from '../data/site';
---
<header class="top" id="top">
  <div class="wrap nav">
    <Logo />
    <nav class="nav-links" aria-label="Principal">
      <a href="#demo" data-spy="demo">Como funciona</a>
      <a href="#preco" data-spy="preco">Preço</a>
      <a href="#duvidas" data-spy="duvidas">Dúvidas</a>
    </nav>
    <a class="login" href={site.urlApp}>Entrar</a>
    <BotaoWhats pequeno />
  </div>
</header>
