---
/* ==========================================================================
   6 · E SE DER ERRADO? As perguntas vem de src/data/faq.ts, a mesma lista
   que alimenta o JSON-LD do FAQPage. O `name` igual em todos os <details>
   faz o navegador fechar um quando outro abre, sem JavaScript.
   ========================================================================== */
import { faq } from '../data/faq';
---
<section class="section" id="duvidas">
  <div class="wrap split faq">
    <div class="head">
      <p class="eyebrow">Dúvidas</p>
      <h2>Ainda com o pé atrás?</h2>
      <p class="lead">Se faltar alguma, pergunte direto pra gente.</p>
    </div>
    <div>
      {faq.map((p) => (
        <details name="faq"><summary>{p.q}<svg class="ico" aria-hidden="true"><use href="#i-down"/></svg></summary><p>{p.a}</p></details>
      ))}
    </div>
  </div>
</section>
