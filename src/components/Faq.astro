---
import Icon from './Icon.astro';
import { faq } from '../data/faq';
---
<section class="section section--tint" id="duvidas">
  <div class="wrap">
    <div class="section__head section__head--center">
      <p class="section__kicker">Dúvidas frequentes</p>
      <h2 class="section__title">O que todo lojista pergunta primeiro</h2>
    </div>

    {/* Mesma lista que alimenta o JSON-LD do FAQPage em Seo.astro — nao da
        mais para a pagina e o schema divergirem. */}
    <div class="faq">
      {faq.map((p) => (
        <details class="faq__item">
          <summary class="faq__q">{p.q}<Icon nome="chevronDown" /></summary>
          <p class="faq__a">{p.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
