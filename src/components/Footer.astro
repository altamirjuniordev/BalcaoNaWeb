---
/* ==========================================================================
   Rodape e a barra fixa do celular.

   A barra (.dock) so existe em tela estreita, onde o botao do topo some:
   aparece depois que a pessoa passa do hero e sai de cena perto do fim,
   para nao cobrir o fechamento (landing.js controla).
   ========================================================================== */
import BotaoWhats from './BotaoWhats.astro';
import { site } from '../data/site';

const ano = new Date().getFullYear();
---
<footer>
  <div class="wrap foot">
    <span>© {ano} {site.nome} · Feito em {site.cidade}</span>
    <nav aria-label="Rodapé">
      <a href="#demo">Como funciona</a>
      <a href="#preco">Preço</a>
      <a href="#duvidas">Dúvidas</a>
      <a href={site.urlApp}>Entrar no painel</a>
    </nav>
  </div>
</footer>

<div class="dock" id="dock"><BotaoWhats bloco /></div>
