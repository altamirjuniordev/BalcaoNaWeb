---
/* ==========================================================================
   1 · O QUE E + FUNCIONA? Promessa e prova na mesma regiao: o simulador
   vem logo abaixo do titulo, dentro do mesmo bloco.
   ========================================================================== */
import BotaoWhats from './BotaoWhats.astro';
import Simulador from './Simulador.astro';
---
<section class="section hero">
  <div class="wrap">
    <h1>Seu delivery, <em>sem comissão</em>.</h1>
    <p class="lead">Cardápio digital com endereço próprio. O cliente pede pelo celular, o pedido toca no seu painel e a comanda sai impressa na cozinha em cerca de 2 segundos.</p>
    <div class="actions">
      <BotaoWhats />
      <a class="btn-link" href="#demo">Testar aqui<svg class="ico-sm" aria-hidden="true"><use href="#i-down"/></svg></a>
    </div>
    <ul class="facts">
      <li><svg class="ico-sm" aria-hidden="true"><use href="#i-check"/></svg>A gente cadastra seu cardápio</li>
      <li><svg class="ico-sm" aria-hidden="true"><use href="#i-check"/></svg>Cliente não instala nada</li>
      <li><svg class="ico-sm" aria-hidden="true"><use href="#i-check"/></svg>Sem fidelidade</li>
    </ul>

    <Simulador />
  </div>
</section>
