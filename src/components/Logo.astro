---
/* ==========================================================================
   Logo da barra do topo: o marcador laranja com o balcao + o nome em texto,
   na fonte dos titulos. Clicar volta ao inicio da pagina.

   O marcador (.logo-mark) tambem e o avatar da conversa do fechamento.
   ========================================================================== */
import { site } from '../data/site';
---
<a class="logo" href="#top" aria-label={`${site.nome}, voltar ao início`}>
  <span class="logo-mark"><svg class="ico-sm" aria-hidden="true"><use href="#i-counter"/></svg></span>{site.nome}
</a>
