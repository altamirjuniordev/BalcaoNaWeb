---
/* ==========================================================================
   Logo da marca.

   Sao duas imagens porque a arte original tem o texto em branco: sobre o
   creme do tema claro ela desaparece. A variante de texto escuro entra no
   claro, a original no escuro, e o CSS decide qual mostrar — mesmo padrao
   do botao de tema, cobrindo os tres estados (escolha explicita do usuario
   nos dois sentidos e preferencia do sistema).

   width/height ficam nos atributos para o navegador reservar o espaco antes
   de baixar a imagem: sem isso a nav pula quando o logo carrega.
   ========================================================================== */
interface Props {
  /** Altura de exibicao em px. O arquivo tem 80px, entao ate 40 fica 2x. */
  altura?: number;
  /** O do rodape esta abaixo da dobra e nao disputa prioridade com o hero. */
  prioridade?: boolean;
}

const { altura = 36, prioridade = false } = Astro.props;
const largura = Math.round(altura * 596 / 200);   // proporcao do arquivo
---
<a class="lp-logo" href="/">
  <img
    class="lp-logo__img lp-logo__img--claro"
    src="/img/logo-claro.png"
    width={largura} height={altura}
    style={`height:${altura}px`}
    alt="Balcão na Web"
    fetchpriority={prioridade ? 'high' : 'auto'}
    loading={prioridade ? 'eager' : 'lazy'}
  />
  <img
    class="lp-logo__img lp-logo__img--escuro"
    src="/img/logo-escuro.png"
    width={largura} height={altura}
    style={`height:${altura}px`}
    alt="Balcão na Web"
    fetchpriority={prioridade ? 'high' : 'auto'}
    loading={prioridade ? 'eager' : 'lazy'}
  />
</a>
