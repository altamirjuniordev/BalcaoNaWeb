---
import Seo from '../components/Seo.astro';
import type { Pergunta } from '../data/faq';

import '../styles/fontes.css';
import '../styles/site.css';

interface Props {
  titulo: string;
  descricao: string;
  caminho?: string;
  perguntas?: Pergunta[];
  noindex?: boolean;
}

const { titulo, descricao, caminho, perguntas, noindex } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- As fontes sao do mesmo dominio, entao o preload dispara junto com o
         parse do HTML, sem esperar o CSS resolver o @font-face. So as duas
         que aparecem no primeiro texto da pagina (titulo e paragrafo); a
         mono entra depois, com os numeros do simulador. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-latin-opsz.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-sans-latin-var.woff2" crossorigin />

    <link rel="icon" href="/img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/img/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/img/favicon-180.png" />
    <!-- A cor do papel (--paper): a barra do navegador continua a pagina. -->
    <meta name="theme-color" content="#FBF7F0" />

    <Seo titulo={titulo} descricao={descricao} caminho={caminho} perguntas={perguntas} noindex={noindex} />

    <!-- A classe `js` no <html> sai daqui, antes da primeira pintura: o CSS
         usa ela para so esconder os blocos da animacao de entrada quando ha
         JS para mostra-los de volta. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip" href="#main">Pular para o conteúdo</a>
    <slot />

    <!-- Astro empacota num unico modulo minificado e com defer. -->
    <script>
      import '../scripts/landing.js';
    </script>
  </body>
</html>
