# ==========================================================================
# Balcão na Web — landing estática no apex.
#
# CONTEXTO: hoje balcaonaweb.com.br e www caem no mesmo app Next.js que
# atende os subdominios dos clientes (titus.balcaonaweb.com.br). Por isso o
# apex responde com a pagina de fallback do multi-tenant — <title>Cardápio</title>
# e o texto "Exemplo: burguer.localhost:3000". Para o Google, o dominio
# principal da marca hoje e uma pagina generica de sistema.
#
# Estes dois blocos resolvem isso sem tocar no app: o Caddy casa o nome de
# host mais especifico primeiro, entao um bloco explicito para o apex vence
# o wildcard dos clientes. O resto continua indo para o Next.js.
#
# Colar no seu Caddyfile ANTES (ou junto) do bloco *.balcaonaweb.com.br.
# ==========================================================================

balcaonaweb.com.br {
	root * /var/www/balcaonaweb-landing
	encode zstd gzip

	# Astro escreve /pagina.html (build.format: 'file'). Sem isto o Caddy
	# nao acha /cardapio-digital, so /cardapio-digital.html.
	try_files {path} {path}.html {path}/index.html

	# Arquivos com hash no nome nunca mudam de conteudo: se o conteudo
	# mudar, o nome muda junto. Cache eterno e seguro.
	@imutavel path /_astro/* /fonts/*
	header @imutavel Cache-Control "public, max-age=31536000, immutable"

	# O HTML precisa revalidar, senao uma correcao de texto demora a
	# aparecer. Hoje o apex responde "no-store", que joga fora ate o
	# cache do navegador.
	@html path / *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	file_server
}

# www e apex respondendo 200 os dois e conteudo duplicado: o Google tem que
# escolher o canonical sozinho. 301 resolve e concentra os sinais num
# endereco so. (Sem este bloco, www cai no wildcard dos clientes e o app
# tenta tratar "www" como se fosse o slug de uma loja.)
www.balcaonaweb.com.br {
	redir https://balcaonaweb.com.br{uri} permanent
}
